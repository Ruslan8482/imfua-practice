# Скопируйте в .env: cp .env.example .env
# ЗАГЛУШКИ: обязательно замените пароль и JWT_SECRET (минимум 32 символа).
LIBREDB_IMAGE=ghcr.io/libredb/libredb-studio:latest
LIBREDB_PORT=3000
ADMIN_EMAIL=admin@libredb.org
ADMIN_PASSWORD=CHANGE_ME_LIBREDB_ADMIN
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
# USER_EMAIL=user@libredb.org
# USER_PASSWORD=CHANGE_ME_LIBREDB_USER
